# Google Gemini API key (used for the extraction/structuring step)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# File validation
MAX_PAGES=3
MAX_FILE_SIZE_MB=15

# OCR
OCR_DPI=200

# Database (SQLite by default - swap for a Postgres URL in production)
DATABASE_URL=sqlite:///./data/documents.db

# Storage
UPLOAD_DIR=./data/uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/app.log
